# Supabase - projeto já existente (NÃO criar um novo projeto)
# Project: jcloztrhwgtvxypybzav
NEXT_PUBLIC_SUPABASE_URL=https://jcloztrhwgtvxypybzav.supabase.co

# Chave publicável/anon do projeto (painel Supabase > Project Settings > API)
# Esta chave é segura para o navegador: o acesso real é controlado pelas
# políticas de RLS no banco, não pelo sigilo desta chave.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Nome público da loja usado em metadados/SEO quando store_settings ainda
# não foi carregado (fallback). Opcional.
NEXT_PUBLIC_SITE_URL=https://designersgr.com.br

# ATENÇÃO: nenhuma chave secreta (service_role) é necessária para o
# funcionamento normal da loja ou do painel administrativo. Caso uma rotina
# de servidor específica venha a precisar de uma chave privada no futuro,
# ela deve ser adicionada aqui SEM o prefixo NEXT_PUBLIC_ e documentada em
# SECURITY.md antes de ser usada. Nunca exponha sb_secret_/service_role no
# bundle do navegador.
